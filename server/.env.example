# Base de datos (SQLite por defecto; para PostgreSQL: postgresql://usuario:clave@host:5432/sgp)
DATABASE_URL="file:./sgp.db"

# Puerto de la API y origen permitido del frontend
PORT=4000
CLIENT_URL=http://localhost:5173

# Clave secreta para firmar los tokens de sesión (usar una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES=8h

# Zona horaria de la empresa (para asistencia y tareas programadas)
TZ=America/Lima

# Correo Gmail para alertas. GMAIL_APP_PASSWORD es una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords), NO la contraseña normal de la cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Sistema de Gestión de Personal

# Administrador inicial creado por el seed
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin123*
